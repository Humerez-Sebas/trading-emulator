# Private sizing-kernel package (RFC-021). The token is NEVER committed: it
# comes from the NPM_GITHUB_TOKEN environment variable (local shell, GitHub
# Actions secret, Vercel environment variable). Classic PAT, read:packages only.
@humerez-sebas:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_GITHUB_TOKEN}
